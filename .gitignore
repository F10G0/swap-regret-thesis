# =========================
# Python cache
# =========================
__pycache__/
*.pyc

# pytest cache
.pytest_cache/

# package metadata generated by local/editable installs
*.egg-info/

# virtual environment
venv/
.venv/
.env

# =========================
# OS junk
# =========================
.DS_Store
Thumbs.db
*:Zone.Identifier

# =========================
# Experiment outputs
# =========================

# raw data (always ignore)
results/raw/*
!results/raw/.gitkeep

# interrupted atomic figure-publication staging directories
results/.figures-*/
data/custom_games/.custom-game-*/

# figures (ignore by default)
results/figures/*
!results/figures/.gitkeep

# allow final figures (for thesis)
!results/figures/final_*.png
!results/figures/final_*.pdf

# isolated generated runs and regenerable caches
results/adversarial/
results/cache/

# dashboard-created games
data/custom_games/*
!data/custom_games/.gitkeep
