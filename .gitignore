# =========================
# Python cache
# =========================
__pycache__/
*.pyc

# pytest cache
.pytest_cache/

# virtual environments
venv/
.venv/
.env/

# =========================
# IDE files
# =========================
.vscode/
.idea/

# =========================
# OS junk
# =========================
.DS_Store
Thumbs.db

# =========================
# LaTeX build files
# =========================
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc

# =========================
# Experiment outputs
# =========================

# raw data (always ignore)
results/raw/*
!results/raw/.gitkeep

# figures (ignore by default)
results/figures/*
!results/figures/.gitkeep

# allow final figures (for thesis)
!results/figures/final_*.png
