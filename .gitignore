# =========================
# Python cache
# =========================
__pycache__/
*.pyc

# pytest cache
.pytest_cache/

# package metadata generated by local/editable installs
*.egg-info/

# PuLP/CBC scratch files left by interrupted solves
*-pulp.lp
*-pulp.mps
*-pulp.mst
*-pulp.sol

# virtual environment
venv/
.env/

# pinned editable games_learning checkout created by `make install`
src/games-learning/

# =========================
# OS junk
# =========================
.DS_Store
Thumbs.db
*:Zone.Identifier

# =========================
# Experiment outputs
# =========================

# raw data (always ignore)
results/raw/*
!results/raw/.gitkeep

# interrupted atomic figure-publication staging directories
results/.figures-*/
web/static/equilibria/.precompute-equilibrium-*/
data/custom_games/.custom-game-*/

# figures (ignore by default)
results/figures/*
!results/figures/.gitkeep

# allow final figures (for thesis)
!results/figures/final_*.png
